# ============================================================
# AzerothCore — variables de entorno del servidor
# Copia este archivo a azerothcore-wotlk/.env y cambia los valores.
# ============================================================

# Contraseña root de MySQL. CAMBIA ESTE VALOR.
DOCKER_DB_ROOT_PASSWORD=CAMBIAR_MYSQL_ROOT_PASSWORD

# MySQL solo escucha en localhost:3307.
DOCKER_DB_EXTERNAL_PORT=3307

# SOAP solo escucha en localhost:7878.
DOCKER_SOAP_EXTERNAL_PORT=7878

# IP donde se publican los puertos del juego (3724 y 8085).
# Usa tu IP de Tailscale, no 0.0.0.0.
DOCKER_BIND_IP=TU_IP_TAILSCALE

# Puertos del juego.
DOCKER_AUTH_EXTERNAL_PORT=3724
DOCKER_WORLD_EXTERNAL_PORT=8085

# Carpeta Data del cliente WoW 3.3.5a (la usa el contenedor de datos).
DOCKER_AC_CLIENT_FOLDER=/ruta/a/tu/cliente/wow/Data

# Opcionales (tienen valores por defecto en docker-compose.yml):
# DOCKER_IMAGE_TAG=master
# DOCKER_USER_ID=1000
# DOCKER_GROUP_ID=1000
# DOCKER_USER=acore
# DOCKER_VOL_DB=ac-database
# DOCKER_VOL_ETC=./env/dist/etc
# DOCKER_VOL_LOGS=./env/dist/logs
# DOCKER_VOL_ROOT=.
