[Unit]
Description=AzerothCore Registration API (FastAPI)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documentos/proyectoX/wow-server/api
EnvironmentFile=%h/Documentos/proyectoX/wow-server/api/.env
ExecStart=%h/Documentos/proyectoX/wow-server/api/venv/bin/uvicorn main:app --host ${API_HOST} --port ${API_PORT}
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
