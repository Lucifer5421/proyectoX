# ============================================================
# API REST de administración de AzerothCore
# Copia este archivo a wow-server/api/.env y cambia los valores.
# ============================================================

# MySQL del servidor WoW (solo local).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=acore_api
DB_PASSWORD=CAMBIAR_MYSQL_API_PASSWORD

# SOAP del worldserver (solo local).
SOAP_URL=http://127.0.0.1:7878/
SOAP_USER=gm
SOAP_PASS=CAMBIAR_GM_PASSWORD

# Socket de Docker. En Docker Desktop puede ser
# unix:///home/TU_USUARIO/.docker/desktop/docker.sock
DOCKER_SOCKET=unix:///var/run/docker.sock

# Clave que deben enviar las rutas protegidas en X-API-Key.
API_KEY=CAMBIAR_API_KEY

# Interfaz/puerto de la API. Usa 127.0.0.1 si es solo local,
# o tu IP de Tailscale si quieres acceder desde otro equipo.
API_HOST=127.0.0.1
API_PORT=8001

# Registro web de cuentas.
REGISTRATION_ENABLED=true
REGISTRATION_CODE=CAMBIAR_CODIGO_REGISTRO
REGISTRATION_MAX=5
REGISTRATION_WINDOW=3600
