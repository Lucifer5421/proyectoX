        <mxCell id="lt" value="Modelo Lógico — Subastas WoW" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="l_jugador" value="&lt;b&gt;jugador&lt;/b&gt;&lt;br&gt;id_jugador SERIAL PK&lt;br&gt;nombre VARCHAR(64) NOT NULL&lt;br&gt;email VARCHAR(128) UNIQUE NOT NULL&lt;br&gt;oro NUMERIC(12,2) DEFAULT 0" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="250" height="160" as="geometry"/></mxCell><mxCell id="l_personaje" value="&lt;b&gt;personaje&lt;/b&gt;&lt;br&gt;id_personaje SERIAL PK&lt;br&gt;id_jugador INT FK -&amp;gt; jugador&lt;br&gt;nombre VARCHAR(64) NOT NULL&lt;br&gt;nivel INT DEFAULT 1&lt;br&gt;clase VARCHAR(30)&lt;br&gt;oro NUMERIC(12,2) DEFAULT 0" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="360" y="80" width="250" height="180" as="geometry"/></mxCell><mxCell id="l_item" value="&lt;b&gt;item&lt;/b&gt;&lt;br&gt;id_item SERIAL PK&lt;br&gt;nombre VARCHAR(100) NOT NULL&lt;br&gt;rareza VARCHAR(30)&lt;br&gt;nivel_requerido INT&lt;br&gt;precio_base NUMERIC(10,2)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="660" y="80" width="250" height="180" as="geometry"/></mxCell><mxCell id="l_inventario" value="&lt;b&gt;inventario&lt;/b&gt;&lt;br&gt;id_inventario SERIAL PK&lt;br&gt;id_personaje INT FK -&amp;gt; personaje&lt;br&gt;id_item INT FK -&amp;gt; item&lt;br&gt;cantidad INT DEFAULT 1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="80" width="250" height="160" as="geometry"/></mxCell><mxCell id="l_subasta" value="&lt;b&gt;subasta&lt;/b&gt;&lt;br&gt;id_subasta SERIAL PK&lt;br&gt;id_vendedor INT FK -&amp;gt; personaje&lt;br&gt;id_item INT FK -&amp;gt; item&lt;br&gt;cantidad INT DEFAULT 1&lt;br&gt;precio_salida NUMERIC(10,2) NOT NULL&lt;br&gt;precio_compra_directa NUMERIC(10,2)&lt;br&gt;duracion_horas INT CHECK (2,8,24)&lt;br&gt;estado VARCHAR(20) DEFAULT 'activa'&lt;br&gt;fecha_inicio TIMESTAMP&lt;br&gt;fecha_fin TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1260" y="80" width="280" height="250" as="geometry"/></mxCell><mxCell id="l_puja" value="&lt;b&gt;puja&lt;/b&gt;&lt;br&gt;id_puja SERIAL PK&lt;br&gt;id_subasta INT FK -&amp;gt; subasta&lt;br&gt;id_comprador INT FK -&amp;gt; personaje&lt;br&gt;monto NUMERIC(10,2) NOT NULL&lt;br&gt;estado VARCHAR(20) DEFAULT 'activa'&lt;br&gt;fecha TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1260" y="420" width="260" height="180" as="geometry"/></mxCell><mxCell id="l_deposito" value="&lt;b&gt;deposito&lt;/b&gt;&lt;br&gt;id_deposito SERIAL PK&lt;br&gt;id_subasta INT FK -&amp;gt; subasta UNIQUE&lt;br&gt;monto NUMERIC(10,2) NOT NULL&lt;br&gt;pagado BOOLEAN DEFAULT false&lt;br&gt;fecha TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="420" width="250" height="160" as="geometry"/></mxCell><mxCell id="l_comision" value="&lt;b&gt;comision&lt;/b&gt;&lt;br&gt;id_comision SERIAL PK&lt;br&gt;id_subasta INT FK -&amp;gt; subasta UNIQUE&lt;br&gt;porcentaje NUMERIC(5,2) NOT NULL&l