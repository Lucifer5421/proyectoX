h="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mt" value="Módulos del modelo lógico 2.1" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="36" as="geometry"/></mxCell><mxCell id="mm" value="&lt;table style=&quot;border-collapse:collapse;font-size:12px;&quot;&gt;&lt;tr style=&quot;background:#1f2937;color:#ffffff;&quot;&gt;&lt;th style=&quot;border:1px solid #888;padding:6px;&quot;&gt;Módulo&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;padding:6px;&quot;&gt;Tabla&lt;/th&gt;&lt;th style=&quot;border:1px solid #888;padding:6px;&quot;&gt;Relación principal&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#dbeafe;&quot;&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;&lt;b&gt;auth&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;jugador&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;1 jugador → N personajes&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#dbeafe;&quot;&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;&lt;b&gt;auth&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;personaje&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;N personajes → 1 jugador; 1 personaje → N subastas, pujas y correos&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#dcfce7;&quot;&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;&lt;b&gt;inventory&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;item&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;1 ítem → N inventarios, subastas y correos&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#dcfce7;&quot;&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;&lt;b&gt;inventory&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;inventario&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;N:M entre personaje e ítem (cantidad)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fef3c7;&quot;&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;&lt;b&gt;auction&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;subasta&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;N:1 personaje e ítem; 1:N pujas; 1:1 con finance&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fef3c7;&quot;&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;&lt;b&gt;auction&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;puja&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;N:1 subasta y personaje comprador&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fce7f3;&quot;&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;&lt;b&gt;finance&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;deposito&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;1:1 con subasta&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fce7f3;&quot;&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;&lt;b&gt;finance&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;comision&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;1:1 con subasta&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fce7f3;&quot;&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;&lt;b&gt;finance&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;transaccion&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;1:1 con subasta; N:1 personaje comprador&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ede9fe;&quot;&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;&lt;b&gt;mail&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;correo&lt;/td&gt;&lt;td style=&quot;border:1px solid #888;padding:6px;&quot;&gt;N:1 personaje destinatario; N:1 ítem (id_item opcional)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1200" height="540" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>