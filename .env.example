# ============================================================
# ProyectoX — Módulo de Subastas WoW
# Copia este archivo a .env antes de levantar Docker.
# PostgreSQL independiente del MySQL del servidor WoW.
# ============================================================

POSTGRES_USER=wow_auction_user
POSTGRES_PASSWORD=wow_auction_password
POSTGRES_DB=wow_auctions
POSTGRES_PORT=5433

APP_PORT=8002
APP_ENV=development

# URL que usa el contenedor de la API (red interna de Docker).
DATABASE_URL=postgresql+psycopg2://wow_auction_user:wow_auction_password@postgres-db:5432/wow_auctions

# URL para herramientas ejecutadas en el host, como el sync de WoW.
DATABASE_URL_LOCAL=postgresql+psycopg2://wow_auction_user:wow_auction_password@localhost:5433/wow_auctions
